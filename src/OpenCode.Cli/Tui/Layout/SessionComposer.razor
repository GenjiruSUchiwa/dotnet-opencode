@namespace OpenCode.Cli.Tui.Layout
@using OpenCode.Cli.Tui.Transcript
@using OpenTui.Blazor.TextMarks

<Box Width="Width" Shrink="0" FocusKey="command-composer">
    <Box Border="left" BorderFg="@(ShellMode ? ShellColor : Theme.Agent)" Bg="@Theme.ElevatedBackground" PaddingX="@(TerminalWidth < 44 ? 1 : 2)" PaddingTop="1">
        @Attachments
        @if (Disabled)
        {
            <TuiText Value="@(Value.Length == 0 ? "Ask anything…" : Value)" Fg="@Theme.Subdued" MaxHeight="@Math.Max(6, TerminalHeight / 3)" />
        }
        else
        {
            <Input Value="@Value" Cursor="Cursor" SelectionAnchor="SelectionAnchor" MaxHeight="@Math.Max(6, TerminalHeight / 3)"
                   Fg="@(Muted ? Theme.Subdued : Theme.Text)" PlaceholderFg="@Theme.Subdued"
                    Placeholder="@(ShellMode ? "Run a command…" : "Ask anything…")" FocusKey="prompt" OnKeyDown="OnKeyDown" OnPaste="OnPaste"
                   OnPointerDown="OnPointerDown" OnPointerMove="OnPointerMove" OnPointerUp="OnPointerUp" OnTextInput="OnTextInput" TextMarks="TextMarks" />
        }
        <Box Height="1" />
        <Box Direction="TuiFlexDirection.Row" Gap="1" Height="1">
            @if (ShellMode || Agent is not null)
            {
                <TuiText Value="@(ShellMode ? "Shell" : Agent)" Fg="@(ShellMode ? ShellColor : Theme.Agent)" Height="1" />
            }
            @if (!ShellMode && TerminalWidth >= 28)
            {
                @if (Agent is not null)
                {
                    <TuiText Value="·" Fg="@Theme.Subdued" Height="1" />
                }
                <Box Shrink="1" Height="1">
                    <TuiText Value="@(Model ?? (Loading ? "Loading model..." : "Select a model"))" Fg="@Theme.Text" Height="1" />
                </Box>
                @if (TerminalWidth >= 50 && Provider is not null)
                {
                    <TuiText Value="@Provider" Fg="@Theme.Subdued" Height="1" />
                }
                @if (TerminalWidth >= 70 && Variant is not null)
                {
                    <TuiText Value="·" Fg="@Theme.Subdued" Height="1" />
                    <TuiText Value="@Variant" Fg="@Theme.Warning" Bold="true" Height="1" />
                }
            }
        </Box>
    </Box>
    <Box Direction="TuiFlexDirection.Row" Width="Width" Height="1" Bg="@Theme.Background">
        <TuiText Value="╹" Width="1" Height="1" Fg="@(ShellMode ? ShellColor : Theme.Agent)" Bg="@Theme.Background" />
        <TuiText Value="@(new string('▀', Math.Max(0, Width - 1)))" Width="@Math.Max(0, Width - 1)" Height="1"
                 Fg="@Theme.ElevatedBackground" Bg="@Theme.Background" />
    </Box>
    <Box Direction="TuiFlexDirection.Row" Gap="2" Height="1">
        <TuiText Value="@(Running ? "[⋯] " + InterruptShortcut + " interrupt" : Directory)" Grow="1" Height="1" Fg="@Theme.Subdued" />
        @if (Summary.ContextLabel is not null || Summary.CostLabel is not null || RunningChildren > 0)
        {
            <TuiText Value="@string.Join(" · ", new[] { RunningChildren > 0 ? $"{RunningChildren} subagent{(RunningChildren == 1 ? "" : "s")}" : null, Summary.ContextLabel, Summary.CostLabel }.Where(value => value is not null))"
                     Height="1" Fg="@Theme.Subdued" />
        }
        else if (!ShellMode && TerminalWidth >= 44 && AgentShortcut.Length > 0)
        {
            <Box Direction="TuiFlexDirection.Row" Gap="1" Height="1">
                <TuiText Value="@AgentShortcut" Height="1" Fg="@Theme.Text" />
                <TuiText Value="agents" Height="1" Fg="@Theme.Subdued" />
            </Box>
        }
        @if (ShellMode)
        {
            <TuiText Value="esc exit shell mode" Fg="@Theme.Subdued" Height="1" />
        }
        else if (TerminalWidth >= 44 && CommandShortcut.Length > 0)
        {
            <Box Direction="TuiFlexDirection.Row" Gap="1" Height="1">
                <TuiText Value="@CommandShortcut" Height="1" Fg="@Theme.Text" />
                <TuiText Value="commands" Height="1" Fg="@Theme.Subdued" />
            </Box>
        }
    </Box>
</Box>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public int Cursor { get; set; }
    [Parameter] public int? SelectionAnchor { get; set; }
    [Parameter] public int Width { get; set; }
    [Parameter] public int TerminalWidth { get; set; }
    [Parameter] public int TerminalHeight { get; set; }
    [Parameter] public string Directory { get; set; } = "";
    [Parameter] public string? Agent { get; set; }
    [Parameter] public string? Model { get; set; }
    [Parameter] public string? Provider { get; set; }
    [Parameter] public string? Variant { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Muted { get; set; }
    [Parameter] public bool ShellMode { get; set; }
    [Parameter] public string? ShellColor { get; set; }
    [Parameter] public bool Running { get; set; }
    [Parameter] public int RunningChildren { get; set; }
    [Parameter] public string AgentShortcut { get; set; } = "";
    [Parameter] public string CommandShortcut { get; set; } = "";
    [Parameter] public string InterruptShortcut { get; set; } = "";
    [Parameter, EditorRequired] public SessionSummary Summary { get; set; } = new(null, null, null);
    [Parameter, EditorRequired] public TranscriptTheme Theme { get; set; } = null!;
    [Parameter] public EventCallback<TerminalKeyEventArgs> OnKeyDown { get; set; }
    [Parameter] public EventCallback<TerminalPasteEventArgs> OnPaste { get; set; }
    [Parameter] public EventCallback<TerminalPointerEventArgs> OnPointerDown { get; set; }
    [Parameter] public EventCallback<TerminalPointerEventArgs> OnPointerMove { get; set; }
    [Parameter] public EventCallback<TerminalPointerEventArgs> OnPointerUp { get; set; }
    [Parameter] public RenderFragment? Attachments { get; set; }
    [Parameter] public IReadOnlyList<TerminalTextMark> TextMarks { get; set; } = [];
    [Parameter] public EventCallback<TerminalTextInputEventArgs> OnTextInput { get; set; }
}

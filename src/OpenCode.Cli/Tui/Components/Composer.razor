@namespace OpenCode.Cli.Tui.Components
@using OpenCode.Cli.Tui.Theme
@using OpenTui.Blazor.TextMarks

<Box Width="Width" Shrink="0" PaddingTop="@(Home ? 1 : 0)">
    <Box Border="@(Compact ? null : "left")" BorderFg="@Colors.Border" Bg="@Colors.PromptBackground"
         PaddingX="@(Compact ? 0 : TerminalWidth < 44 ? 1 : 2)" PaddingTop="@(Compact ? 0 : 1)">
        @Attachments
        <Input Value="@Value" Cursor="Cursor" SelectionAnchor="SelectionAnchor" MaxHeight="@Math.Max(6, TerminalHeight / 3)"
               Placeholder="@(ShellMode ? "Run a command…" : "Ask anything...")" Fg="@Colors.InputText" Bg="@Colors.PromptBackground" PlaceholderFg="@Colors.PlaceholderText"
               FocusKey="prompt" OnKeyDown="OnKeyDown" OnPaste="OnPaste" OnTextInput="OnTextInput" TextMarks="TextMarks" />
        @if (!Compact)
        {
            <Box Height="1" />
            <Box Direction="TuiFlexDirection.Row" Gap="1" Height="1">
                    @if (ShellMode || Agent is not null)
                    {
                        <TuiText Value="@(ShellMode ? "Shell" : Agent)" Height="1" Fg="@Colors.Agent" />
                    }
                    @if (!ShellMode && TerminalWidth >= 28 && Model is not null)
                    {
                        @if (Agent is not null)
                        {
                            <TuiText Value="·" Height="1" Fg="@Colors.Subdued" />
                        }
                        <Box Direction="TuiFlexDirection.Row" Grow="1" Shrink="1" Gap="1" Height="1">
                            <Box Shrink="1" Height="1">
                                <TuiText Value="@Model" Height="1" Fg="@Colors.Model" />
                            </Box>
                            @if (TerminalWidth >= 50 && Provider is not null)
                            {
                                <TuiText Value="@Provider" Height="1" Fg="@Colors.Subdued" />
                            }
                            @if (TerminalWidth >= 70 && Variant is not null)
                            {
                                <TuiText Value="·" Height="1" Fg="@Colors.Subdued" />
                                <TuiText Value="@Variant" Height="1" Fg="@Colors.Variant" Bold="true" />
                            }
                        </Box>
                    }
                    else if (!ShellMode && TerminalWidth >= 28)
                    {
                        <TuiText Value="@(Loading ? "Loading model..." : "Select a model")" Height="1" Fg="@Colors.Subdued" />
                    }
            </Box>
        }
    </Box>
    @if (!Compact)
    {
        <Box Direction="TuiFlexDirection.Row" Width="Width" Height="1" Bg="@Colors.PageBackground">
            <TuiText Value="@(Colors.OpaquePrompt ? "╹" : " ")" Fg="@Colors.Border" Bg="@Colors.PageBackground" Width="1" Height="1" />
            <TuiText Value="@(new string(Colors.OpaquePrompt ? '▀' : ' ', Math.Max(0, Width - 1)))" Fg="@Colors.PromptBackground" Bg="@Colors.PageBackground" Width="@Math.Max(0, Width - 1)" Height="1" />
        </Box>
        <Box Direction="TuiFlexDirection.Row" Gap="2" Height="1">
            <Box Grow="1" Shrink="1" Height="1">
                <TuiText Value="@CurrentDirectory" Height="1" Fg="@Colors.Subdued" />
            </Box>
            @if (ShellMode)
            {
                <TuiText Value="esc exit shell mode" Fg="@Colors.Subdued" Height="1" />
            }
            else if (TerminalWidth >= 44 && CommandShortcut.Length > 0)
            {
                <Box Direction="TuiFlexDirection.Row" Gap="1" Height="1">
                    <TuiText Value="@CommandShortcut" Height="1" Fg="@Colors.ActionText" />
                    <TuiText Value="commands" Height="1" Fg="@Colors.Subdued" />
                </Box>
            }
        </Box>
    }
</Box>

@code {
    [Parameter] public ComposerTheme? Theme { get; set; }
    private ComposerTheme Colors => Theme ?? ComposerTheme.Default;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public int Cursor { get; set; }
    [Parameter] public int? SelectionAnchor { get; set; }
    [Parameter] public int Width { get; set; }
    [Parameter] public int TerminalWidth { get; set; }
    [Parameter] public int TerminalHeight { get; set; }
    [Parameter] public bool Home { get; set; }
    [Parameter] public bool ShellMode { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string CommandShortcut { get; set; } = "";
    [Parameter] public string CurrentDirectory { get; set; } = "";
    [Parameter] public string? Agent { get; set; }
    [Parameter] public string? Model { get; set; }
    [Parameter] public string? Provider { get; set; }
    [Parameter] public string? Variant { get; set; }
    [Parameter] public EventCallback<TerminalKeyEventArgs> OnKeyDown { get; set; }
    [Parameter] public EventCallback<TerminalPasteEventArgs> OnPaste { get; set; }
    [Parameter] public RenderFragment? Attachments { get; set; }
    [Parameter] public IReadOnlyList<TerminalTextMark> TextMarks { get; set; } = [];
    [Parameter] public EventCallback<TerminalTextInputEventArgs> OnTextInput { get; set; }
    private bool Compact => TerminalHeight < 6;
}

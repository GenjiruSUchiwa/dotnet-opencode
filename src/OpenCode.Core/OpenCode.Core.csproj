<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenCode.Schema\OpenCode.Schema.csproj" />
    <ProjectReference Include="..\Runtime.Time\Runtime.Time.csproj" />
    <Using Include="Runtime.Time" />
    <ProjectReference Include="..\Transport.Pipelines\Transport.Pipelines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vogen" Version="8.0.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="Jint" Version="4.16.1" />
    <PackageReference Include="Acornima" Version="1.7.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Build\ImportPublicModels.cs" />
    <EmbeddedResource Include="Llm\models-dev.public.json" LogicalName="OpenCode.Core.ModelsDev.PublicSnapshot.json" />
  </ItemGroup>

  <UsingTask TaskName="ImportPublicModels" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Reference Include="$(MSBuildToolsPath)\Sdks\Microsoft.NET.Sdk\tools\net472\Newtonsoft.Json.dll" />
      <Code Type="Class" Language="cs" Source="$(MSBuildProjectDirectory)\Build\ImportPublicModels.cs" />
    </Task>
  </UsingTask>

  <!-- Explicit source-data generation only; normal builds never read another checkout or use the network. -->
  <Target Name="ImportPublicModelsResource">
    <Error Condition="'$(PublicModelsSnapshotSource)' == ''" Text="Supply PublicModelsSnapshotSource pointing to the tracked upstream public snapshot.txt." />
    <ImportPublicModels SourceFile="$(PublicModelsSnapshotSource)" DestinationFile="$(MSBuildProjectDirectory)\Llm\models-dev.public.json" />
  </Target>

</Project>

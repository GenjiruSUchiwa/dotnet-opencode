<Project>
  <!-- Source projects only. Tests retain their existing package/configuration and
       are not part of the authorized analyzer migration build. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)src'))">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>11.0</AnalysisLevel>
    <MeziantouAnalysisMode>Default</MeziantouAnalysisMode>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <OpenCodeLocalBuild Condition="'$(OpenCodeLocalBuild)' == ''">false</OpenCodeLocalBuild>
    <OpenCodeFingerprintOnly Condition="'$(OpenCodeFingerprintOnly)' == ''">false</OpenCodeFingerprintOnly>
    <DefineConstants Condition="'$(OpenCodeLocalBuild)' == 'true'">$(DefineConstants);OPENCODE_DOTNET_LOCAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)src'))">
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.203" PrivateAssets="all"
                      IncludeAssets="build;analyzers;buildtransitive" />
  </ItemGroup>
</Project>
